# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Claude Code local metadata
.claude/

# VS Code (commit only the dev workflow configs)
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# JetBrains
.idea/

# Blender auto-saves and temps
*.blend1
*.blend2
*.blend@

# Generated bake output — shape: <blend_dir>/depth_peel_xr/<scene>/{temp,captures,usd}/
# Narrow patterns so the add-on's own `depth_peel_xr/` package (our repo root) isn't ignored.
**/depth_peel_xr/*/temp/
**/depth_peel_xr/*/captures/
**/depth_peel_xr/*/usd/

# OIIO / render intermediates scattered at root level (shouldn't happen, but defensive)
/*.exr
/*.png
/*.usda
/*.usd
/*.usdc
/*.usdz

# Local test scenes
blends/

# Editor temp files
*.swp
*.bak
*~
